# External backup/recovery worker only. Never install these on the API runtime.
BACKUP_DATABASE_URL=postgresql+psycopg://BACKUP_USER:PASSWORD@DIRECT_SOURCE_HOST/clyra?sslmode=require
RESTORE_DATABASE_URL=postgresql+psycopg://OWNER:PASSWORD@DIFFERENT_EMPTY_HOST/clyra_restore?sslmode=require
BACKUP_AGE_RECIPIENT=age1PUBLIC_RECIPIENT
BACKUP_AGE_IDENTITY_FILE=/secure/recovery-identity.txt
BACKUP_OUTPUT_DIR=/secure/encrypted-backups
BACKUP_REMOTE=protected-remote:clyra-backups
BACKUP_MONITOR_URL=https://YOUR_MONITOR/SECRET_SUCCESS_ENDPOINT
APPLICATION_DB_ROLE=clyra_app
