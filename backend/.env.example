DATABASE_URL=postgresql+psycopg://APP_USER:PASSWORD@HOST/DATABASE?sslmode=require
ENVIRONMENT=development
# Session lifetime is fixed at 8 hours by the existing API contract.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
APPLICATION_DB_ROLE=clyra_app
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set seed credentials locally only; remove after seeding.
# SUPER_ADMIN_USERNAME=
# SUPER_ADMIN_PASSWORD=
